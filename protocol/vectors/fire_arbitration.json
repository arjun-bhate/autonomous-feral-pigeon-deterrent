    {
      "id": "rate.no_per_minute_limit",
      "description": "Three 5000 ms requests at 0, 10 s and 20 s are all granted (15 s of on-time in 25 s); no reply carries code 13.",
      "covers": ["retired:RATE_LIMIT"],
      "config": {"elevation_max_cdeg": 4000},
      "initial": {"state": "SCANNING", "homed": true, "armed": true, "key_on": true, "pan_cdeg": 5000, "tilt_cdeg": 3000, "zones": [{"zone_id": 1, "points": [[9500, 2000], [11500, 2000], [11500, 3000], [9500, 3000]]}]},
      "heartbeats": [{"from_ms": 0, "until_ms": 25000}],
      "steps": [
        {"at_ms": 0, "action": "send", "message": {"type": "FIRE_REQUEST", "fields": {"ttl_ms": 500, "duration_ms": 5000, "issued_at_ms": 0}}, "expect_reply": {"result": "GRANTED"}},
        {"at_ms": 10000, "action": "send", "message": {"type": "FIRE_REQUEST", "fields": {"ttl_ms": 500, "duration_ms": 5000, "issued_at_ms": 10000}}, "expect_reply": {"result": "GRANTED"}},
        {"at_ms": 20000, "action": "send", "message": {"type": "FIRE_REQUEST", "fields": {"ttl_ms": 500, "duration_ms": 5000, "issued_at_ms": 20000}}, "expect_reply": {"result": "GRANTED"}},
        {"at_ms": 25000, "action": "advance"}
      ],
      "expect": {"state": "COOLDOWN", "effector_on": false, "fault_mask": [], "events": [{"event": "on", "at_ms": 0}, {"event": "normal_end", "at_ms": 5000}, {"event": "on", "at_ms": 10000}, {"event": "normal_end", "at_ms": 15000}, {"event": "on", "at_ms": 20000}, {"event": "normal_end", "at_ms": 25000}], "counters": {"fire_granted": 3, "rejected.total": 0}}
    }
