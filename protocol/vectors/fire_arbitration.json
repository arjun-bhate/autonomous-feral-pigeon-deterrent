{
  "protocol_version": "0.1",
  "vectors": [
    {
      "id": "fire.grant.all_conditions_hold",
      "description": "Every condition holds, so the fire request is granted.",
      "covers": ["grant:ALL_CONDITIONS"],
      "config": {"elevation_max_cdeg": 4000},
      "initial": {"state": "SCANNING", "homed": true, "armed": true, "key_on": true, "pan_cdeg": 5000, "tilt_cdeg": 3000, "zones": [{"zone_id": 1, "points": [[9500, 2000], [11500, 2000], [11500, 3000], [9500, 3000]]}]},
      "steps": [
        {"at_ms": 0, "action": "send", "message": {"type": "FIRE_REQUEST", "fields": {"issued_at_ms": 0, "ttl_ms": 500, "duration_ms": 500}}, "expect_reply": {"result": "GRANTED"}}
      ],
      "expect": {"state": "DETER", "effector_on": true, "armed": true, "fault_mask": [], "events": [{"event": "on", "at_ms": 0}]}
    },
    {
      "id": "fire.deny.heartbeat_lost",
      "description": "No heartbeat has been accepted yet; every other condition holds.",
      "covers": ["deny:HEARTBEAT_LOST"],
      "config": {"elevation_max_cdeg": 4000},
      "initial": {"state": "SCANNING", "homed": true, "armed": true, "key_on": true, "pan_cdeg": 5000, "tilt_cdeg": 3000, "zones": [{"zone_id": 1, "points": [[9500, 2000], [11500, 2000], [11500, 3000], [9500, 3000]]}], "no_heartbeat": true},
      "steps": [
        {"at_ms": 0, "action": "send", "message": {"type": "FIRE_REQUEST", "fields": {"issued_at_ms": 0, "ttl_ms": 500, "duration_ms": 500}}, "expect_reply": {"result": "DENIED", "code": "HEARTBEAT_LOST"}}
      ],
      "expect": {"state": "SCANNING", "effector_on": false, "armed": true, "fault_mask": [], "events": []}
    },
    {
      "id": "fire.deny.fault_active_reserved",
      "description": "A reserved fault bit (INTERNAL) is set, injected; every other condition holds.",
      "covers": ["deny:FAULT_ACTIVE"],
      "config": {"elevation_max_cdeg": 4000},
      "initial": {"state": "SCANNING", "homed": true, "armed": true, "key_on": true, "pan_cdeg": 5000, "tilt_cdeg": 3000, "zones": [{"zone_id": 1, "points": [[9500, 2000], [11500, 2000], [11500, 3000], [9500, 3000]]}], "fault_mask": ["INTERNAL"]},
